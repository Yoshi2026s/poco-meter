{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "RIPGREP_CONFIG_PATH": ".claude/ripgreprc"
  },
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run check)",
      "Bash(npm run -s check)",
      "Bash(npm run test:extra)",
      "Bash(npm run pages:build)",
      "Bash(npm run version:bump)",
      "Bash(bash scripts/check.sh)",
      "Bash(bash scripts/test-extra.sh:*)",
      "Bash(node --test:*)",
      "Bash(node tests/:*)",
      "Bash(node scripts/build-pages.mjs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)"
    ],
    "deny": [
      "Edit(./data/borders.json)",
      "Write(./data/borders.json)"
    ]
  }
}
